# Application Environment Configuration
PROJECT_NAME="EVE Healthcare Diagnostic Booking & Payment Service"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Database: SQLite (default local) or PostgreSQL (production/docker)
DATABASE_URL="sqlite:///./eve_healthcare.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eve_healthcare"

# JWT Authentication
SECRET_KEY="eve-healthcare-jwt-super-secret-key-change-in-production-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Webhook Security (HMAC Secret)
WEBHOOK_SECRET="eve_whsec_9938481237a89f81b2c"

# Redis & Caching
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=300

# Celery Task Queue
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Rate Limiting
RATE_LIMIT_DEFAULT="100/minute"
ENVIRONMENT="development"
